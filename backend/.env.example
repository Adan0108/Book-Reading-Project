PORT=3000
NODE_ENV=development
# Production defaults to verification only. Back up/review and run npm run migrate explicitly.
MIGRATIONS_AUTO_APPLY=false
# Empty means no trusted proxy. For a controlled gateway use its exact IP/CIDR.
TRUST_PROXY_CIDRS=

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DB=mydb

# Redis / ioredis
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional authenticated/TLS Redis connection URL (server only).
REDIS_URL=

# Email (Gmail via STARTTLS)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=<email>
EMAIL_PASSWORD=<password>
EMAIL_FROM="Web Name <email@gmail.com>"
EMAIL_ALLOW_SELF_SIGNED=false

# Signed preset: JPEG/PNG/WebP, max_file_size=10485760, overwrite=false, no transformations.
CLOUDINARY_PUBLISHING_PRESET=book_publishing_signed_v1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public browser origin; used for CORS and server-selected checkout return URLs.
FRONTEND_URL=http://localhost:8000
# Optional sandbox billing. Leave empty to display honest unavailable controls.
# Never configure a live key for this MVP. Webhook API version: 2026-10-28.endive.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
