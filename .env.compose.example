# Copy to ignored .env.compose and replace both passwords with different random values.
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_PASSWORD=replace-with-random-application-password
HTTP_PORT=8080
MAILPIT_PORT=8025
FRONTEND_URL=http://localhost:8080
# Local HTTP only. For deployment use HTTPS and NODE_ENV=production with validated SMTP TLS.
NODE_ENV=development
# Optional integrations; never put these in a frontend variable or Docker build argument.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PUBLISHING_PRESET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
